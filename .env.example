# Configuration for Pathshala.
#
# The API reads ASP.NET Core configuration. Environment variables map to
# configuration keys with a double underscore: Jwt__Secret -> Jwt:Secret.
# Nothing loads this file automatically: export these variables in your shell,
# use `dotnet user-secrets`, or set them in your hosting provider.

# ---- Backend (backend/AssignmentSystem.Api) ----
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=assignment_system;Username=postgres;Password=CHANGE_ME

# Required. At least 32 bytes. Generate one with: openssl rand -base64 48
Jwt__Secret=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
Jwt__Issuer=AssignmentSystem
Jwt__Audience=AssignmentSystem
Jwt__ExpiryHours=8

# Comma-separated list of frontend origins allowed by CORS.
Cors__AllowedOrigins=http://localhost:3000,http://localhost:3001

# ---- Frontend (frontend/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:5000
