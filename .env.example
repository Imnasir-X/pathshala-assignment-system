# Environment variables for the Assignment Management System
# Copy this file to .env (backend) or .env.local (frontend) and fill in real values

# Backend
DB_HOST=localhost
DB_PORT=5432
DB_NAME=assignment_system
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=YOUR_JWT_SECRET_AT_LEAST_32_CHARACTERS_LONG!!
JWT_ISSUER=AssignmentSystem
JWT_AUDIENCE=AssignmentSystem
JWT_EXPIRY_HOURS=8

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000
